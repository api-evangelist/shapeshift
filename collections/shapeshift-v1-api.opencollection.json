            "name": "GetAccount",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bitcoin.shapeshift.com/api/v1/account/:pubkey",
            "params": [
              {
                "name": "pubkey",
                "value": "",
                "type": "path",
                "description": "account address or extended public key"
              }
            ]
          },
          "docs": "Get account details by address or extended public key"
        },
        {
          "info": {
            "name": "GetTxHistory",
            "type": "http"
